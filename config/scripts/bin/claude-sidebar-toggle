#!/usr/bin/env bash
# サイドバーの開閉。サイドバーペインは pane オプション @agent_sidebar=1 で識別する。
#   引数なし  : トグル(在れば閉じ、無ければ開く) … prefix+b 用
#   ensure    : 無ければ開くだけ(在れば何もしない) … after-new-window フック用
set -uo pipefail
[ -n "${TMUX:-}" ] || exit 0
mode="${1:-toggle}"
WIDTH="${CLAUDE_SIDEBAR_WIDTH:-32}"

existing=$(tmux list-panes -F '#{@agent_sidebar}	#{pane_id}' 2>/dev/null | awk -F'\t' '$1=="1"{print $2; exit}')
if [ -n "$existing" ]; then
  [ "$mode" = "ensure" ] && exit 0   # 既に開いている
  tmux kill-pane -t "$existing"
  exit 0
fi

# 左に固定幅で分割 → 目印付与 → フォーカスを元ペインに戻す。
cur=$(tmux display-message -p '#{pane_id}')
new=$(tmux split-window -h -b -l "$WIDTH" -P -F '#{pane_id}' "exec claude-agents-sidebar")
tmux set-option -p -t "$new" @agent_sidebar 1
tmux select-pane -t "$cur"
